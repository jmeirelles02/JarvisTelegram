# --- Jarvis ---
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Canal ativo: Telegram por padrão ---
JARVIS_CHANNEL=telegram
TELEGRAM_TOKEN=
# IDs numéricos autorizados, separados por vírgula. Vazio permite qualquer usuário.
TELEGRAM_USER_IDS=

# --- Evolution API (apenas quando JARVIS_CHANNEL=whatsapp) ---
EVOLUTION_URL=http://evolution:8080
EVOLUTION_INSTANCE=jarvis
EVOLUTION_APIKEY=            # gere: openssl rand -hex 32
POSTGRES_PASSWORD=           # gere: openssl rand -hex 16
WEBHOOK_TOKEN=               # gere: openssl rand -hex 24

# Números autorizados a falar com o bot, separados por vírgula (DDI+DDD+numero).
# Vazio = qualquer um. Preencha: menos token gasto e menos risco de ban.
NUMEROS_PERMITIDOS=5511999999999

# --- Assistente pessoal ---
JARVIS_TIMEZONE=America/Sao_Paulo

# Escolha icloud ou google. Vazio desativa apenas a integração com calendário.
# Credenciais de uma conta pessoal, acessível SOMENTE ao identificador abaixo.
# Telegram: ID numérico retornado por /meuid. WhatsApp: telefone DDI+DDD+número.
CALENDAR_PROVIDER=
CALENDAR_USER_ID=

# iCloud: senha específica de app gerada em account.apple.com (nunca a senha principal).
# O nome deve coincidir exatamente com um único calendário; consulte /calendarios.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDAR_NAME=

# Google: OAuth com acesso offline e escopo calendar.events.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
